<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.MyA.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:minHeight">@dimen/button_height_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="elevation">3dp</item>
    </style>

    <style name="Widget.MyA.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="Widget.MyA.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav_rounded</item>
        <item name="android:elevation">18dp</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>
</resources>
