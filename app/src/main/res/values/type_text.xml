<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Editorial-style headings (system sans-serif medium where available) -->
    <style name="TextAppearance.MyA.HeroTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.MyA.SectionOverline" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="TextAppearance.MyA.CardTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.MyA.SheetTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>
</resources>
