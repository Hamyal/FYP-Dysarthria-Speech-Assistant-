<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: diagonal sage–mint wash -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="145"
                android:centerColor="@color/splash_gradient_mid"
                android:endColor="@color/splash_gradient_corner"
                android:startColor="@color/splash_gradient_start"
                android:type="linear" />
        </shape>
    </item>
    <!-- Soft teal depth (bottom-right) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="@android:color/transparent"
                android:endColor="@color/splash_overlay_teal"
                android:startColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>
    <!-- Subtle light bloom (top) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent"
                android:startColor="#40FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
