<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <!-- Bottom sheet drag affordance -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_drag_handle" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:text="@string/sheet_choose_photo_title"
        android:textAppearance="@style/TextAppearance.MyA.SheetTitle"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="24dp"
        android:text="@string/profile_photo_favorites_hint"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/on_surface_variant"
        android:lineSpacingMultiplier="1.15" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/primary_container"
        app:cardCornerRadius="@dimen/card_radius_xl"
        app:cardElevation="@dimen/card_elevation_soft"
        app:strokeColor="@color/primary_light"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_photo_favorites"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.MyA.SectionOverline" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:paddingEnd="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="4dp"
                        app:rippleColor="@color/primary"
                        app:strokeColor="@color/white"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:id="@+id/preset_1"
                            android:layout_width="@dimen/sheet_avatar_preset"
                            android:layout_height="@dimen/sheet_avatar_preset"
                            android:contentDescription="@string/preset_avatar_1"
                            android:scaleType="centerCrop" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="4dp"
                        app:rippleColor="@color/primary"
                        app:strokeColor="@color/white"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:id="@+id/preset_2"
                            android:layout_width="@dimen/sheet_avatar_preset"
                            android:layout_height="@dimen/sheet_avatar_preset"
                            android:contentDescription="@string/preset_avatar_2"
                            android:scaleType="centerCrop" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="4dp"
                        app:rippleColor="@color/primary"
                        app:strokeColor="@color/white"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:id="@+id/preset_3"
                            android:layout_width="@dimen/sheet_avatar_preset"
                            android:layout_height="@dimen/sheet_avatar_preset"
                            android:contentDescription="@string/preset_avatar_3"
                            android:scaleType="centerCrop" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="4dp"
                        app:rippleColor="@color/primary"
                        app:strokeColor="@color/white"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:id="@+id/preset_4"
                            android:layout_width="@dimen/sheet_avatar_preset"
                            android:layout_height="@dimen/sheet_avatar_preset"
                            android:contentDescription="@string/preset_avatar_4"
                            android:scaleType="centerCrop" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="4dp"
                        app:rippleColor="@color/primary"
                        app:strokeColor="@color/white"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:id="@+id/preset_5"
                            android:layout_width="@dimen/sheet_avatar_preset"
                            android:layout_height="@dimen/sheet_avatar_preset"
                            android:contentDescription="@string/preset_avatar_5"
                            android:scaleType="centerCrop" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pick_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0.02"
        android:minHeight="56dp"
        android:text="@string/choose_photo_from_device"
        android:textSize="15sp"
        app:cornerRadius="@dimen/card_radius_sm"
        app:elevation="2dp"
        app:icon="@drawable/ic_photo_library"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/on_primary" />

</LinearLayout>
