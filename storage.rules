rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Patient drill recordings (WAV). Write only as that patient. Read: any signed-in user
    // (therapist playback uses the same Firebase Auth session; RTDB assignment cannot be read here.
    // To lock reads to patient+therapist only, use custom claims + rules, or signed URLs from Cloud Functions.)
    match /recordings/{patientId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == patientId
        && request.resource.size < 30 * 1024 * 1024
        && (request.resource.contentType.matches('audio/.*')
            || request.resource.contentType == 'application/octet-stream');
    }
    // Profile photos (patient or therapist): one file per auth uid
    match /profile_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
