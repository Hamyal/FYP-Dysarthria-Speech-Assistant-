rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Patient drill recordings: only that patient may upload; any signed-in user can read
    // (therapists use download URLs; stricter read would require Custom Claims for therapist role.)
    match /recordings/{patientId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == patientId;
    }
    // Profile photos (patient or therapist): one file per auth uid
    match /profile_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
